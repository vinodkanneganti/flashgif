# Monorepo-wide ignores. Per-project ignores live in backend/.gitignore and
# web/.gitignore so each tool's idiomatic patterns are self-contained.

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors / IDEs ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.vs/
*.swp
*.swo
*~

# --- Env / secrets (NEVER commit) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
secrets/

# --- Docker / ops data volumes ---
ops/data/

# --- Logs (anywhere) ---
*.log
logs/

# --- Mobile placeholders (when ios/ and android/ land later) ---
# Android
*.apk
*.ap_
*.aab
local.properties
captures/
# iOS
xcuserdata/
*.xcuserstate
DerivedData/
